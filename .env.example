# =============================================
# invoiceFast — Environment Configuration
# =============================================
# Copy this file to .env and adjust values

# AI Model (Ollama)
# Available models: https://ollama.com/library
# Recommended options:
#   qwen2.5:7b     — fast, good quality, ~4GB RAM
#   qwen2.5:14b    — better quality, ~8GB RAM
#   mistral:7b     — fast alternative, ~4GB RAM
#   llama3.2:3b    — very fast, minimal RAM, lower quality
#   phi4:14b       — Microsoft, excellent reasoning, ~8GB RAM
#
# NOTE: "gpt-oss-20b" does not exist in Ollama.
# Use one of the models above instead.
OLLAMA_MODEL=qwen2.5:7b
